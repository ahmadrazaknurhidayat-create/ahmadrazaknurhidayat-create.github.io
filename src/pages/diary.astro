---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Catatan Harian">

  <section class="diary">

    <div class="header">
      <h1>Catatan Harian</h1>

      <p>
        Setiap cerita memiliki lembarannya sendiri,
        dan setiap kenangan memiliki maknanya.
      </p>
    </div>


    <div class="cards">

      <a href="/diary/cecilia" class="card cecilia">
        <div class="icon">💙</div>

        <h2>Kak Cecilia</h2>

        <p>
          Kumpulan kenangan, pesan,
          dan cerita yang tersimpan.
        </p>

        <span>Buka Lembaran →</span>
      </a>


      <a href="/diary/mamayo" class="card mamayo">
        <div class="icon">🌸</div>

        <h2>Mamayo Naisu</h2>

        <p>
          Catatan perjalanan,
          obrolan, dan kebersamaan.
        </p>

        <span>Buka Lembaran →</span>
      </a>


      <a href="/diary/aku" class="card aku">
        <div class="icon">✨</div>

        <h2>Diriku</h2>

        <p>
          Perjalanan hidup,
          refleksi, dan mimpi.
        </p>

        <span>Buka Lembaran →</span>
      </a>

    </div>

  </section>


  <style>

    .diary {
      min-height:80vh;
      padding:70px 20px;
      background:#f8fafc;
    }


    .header {
      text-align:center;
      max-width:700px;
      margin:auto;
    }


    h1 {
      font-size:45px;
      color:#1e3a8a;
    }


    .header p {
      font-size:20px;
      color:#64748b;
    }


    .cards {
      margin-top:50px;
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:30px;
      max-width:1100px;
      margin-left:auto;
      margin-right:auto;
    }


    .card {
      padding:35px;
      border-radius:25px;
      text-decoration:none;
      color:#1f2937;
      background:white;
      box-shadow:0 10px 25px rgba(0,0,0,.08);
      transition:.3s;
    }


    .card:hover {
      transform:translateY(-10px);
    }


    .icon {
      font-size:50px;
    }


    .card span {
      display:block;
      margin-top:20px;
      font-weight:bold;
    }


    .cecilia {
      border-top:6px solid #2563eb;
    }


    .mamayo {
      border-top:6px solid #ec4899;
    }


    .aku {
      border-top:6px solid #f59e0b;
    }


  </style>

</Layout>