---
import Layout from "../layouts/Layout.astro";

import Hero from "../components/Hero.astro";
import SearchBar from "../components/SearchBar.astro";
import Categories from "../components/Categories.astro";
import LatestPosts from "../components/LatestPosts.astro";
import Quote from "../components/Quote.astro";
import Footer from "../components/Footer.astro";
import Stats from "../components/Stats.astro";
import FeaturedPost from "../components/FeaturedPost.astro";
import "../styles/home.css";
---

<Layout title="Lembaran Memori">

  <main class="home">

    <!-- Hero -->
    <Hero />

    <!-- Search -->
    <SearchBar />

    <FeaturedPost
  title="Lembaran Pertama"
  date="6 Agustus 2026"
  description="Hari ini aku memulai lembaran pertama di website Lembaran Memori. Sebuah tempat untuk menyimpan cerita, perjalanan, dan kenangan yang berharga."
  href="/diary/cecilia/catatan/2026-08-06-lembaran-pertama"
/>
    <!-- Kategori -->
    <Categories />

    <!-- Catatan Terbaru -->
    <LatestPosts />

    <!-- Quote -->
    <Quote />

  </main>

  <!-- Footer -->
  <Footer />

</Layout>