---
import Layout from "../../../layouts/Layout.astro";
import Card from "../../../components/Card.astro";
---

<Layout title="Kak Cecilia">

<section class="cecilia-page">

<div class="container">

<h1>💙 Lembaran Untuk Kak Cecilia</h1>

<p class="intro">
Sebuah ruang kecil untuk menyimpan cerita,
kenangan, dan tulisan yang memiliki makna.
</p>

<div class="sections">

<Card
icon="🌊"
title="Pembuka"
description="Sebuah halaman awal yang berisi cerita mengapa lembaran ini dibuat."
href="/diary/cecilia/pembuka"
/>

<Card
icon="📖"
title="Catatan Harian"
description="Kumpulan cerita dan momen yang tersimpan."
href="/diary/cecilia/catatan"
/>

<Card
icon="💌"
title="Surat & Pesan"
description="Tulisan khusus dan pesan yang ingin disampaikan."
href="#"
/>

<Card
icon="🎵"
title="Lirik & Puisi"
description="Kumpulan puisi dan karya tulisan."
href="#"
/>

<Card
icon="🎬"
title="Momen & Kenangan"
description="Cerita dari berbagai momen berkesan."
href="#"
/>

<Card
icon="✨"
title="Harapan & Doa"
description="Doa dan harapan baik."
href="#"
/>

</div>

</div>

</section>

</Layout>