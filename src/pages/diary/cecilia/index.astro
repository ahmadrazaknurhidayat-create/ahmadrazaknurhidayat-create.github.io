---
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="Kak Cecilia">

<section class="cecilia-page">

  <div class="container">

    <h1>
      💙 Lembaran Untuk Kak Cecilia
    </h1>

    <p class="intro">
      Sebuah ruang kecil untuk menyimpan cerita,
      kenangan, dan tulisan yang memiliki makna.
    </p>


    <div class="sections">


      <a href="/diary/cecilia/pembuka" class="card">

        <h2>
          🌊 Pembuka
        </h2>

        <p>
          Sebuah halaman awal yang berisi
          cerita mengapa lembaran ini dibuat.
        </p>

      </a>


      <a href="/diary/cecilia/2026-08-06-lembaran-pertama" class="card">

  <h2>
    📖 Catatan Harian
  </h2>

  <p>
    Kumpulan cerita dan momen
    yang tersimpan.
  </p>

</a>

      <a href="#" class="card">

        <h2>
          💌 Surat & Pesan
        </h2>

        <p>
          Tulisan khusus dan pesan
          yang ingin disampaikan.
        </p>

      </a>


      <a href="#" class="card">

        <h2>
          🎵 Lirik & Puisi
        </h2>

        <p>
          Kumpulan puisi dan karya tulisan.
        </p>

      </a>


      <a href="#" class="card">

        <h2>
          🎬 Momen & Kenangan
        </h2>

        <p>
          Cerita dari berbagai momen berkesan.
        </p>

      </a>


      <a href="#" class="card">

        <h2>
          ✨ Harapan & Doa
        </h2>

        <p>
          Doa dan harapan baik.
        </p>

      </a>


    </div>

  </div>

</section>


<style>

.cecilia-page {

  min-height:80vh;

  padding:70px 20px;

  background:#eff6ff;

}


.container {

  max-width:1100px;

  margin:auto;

}


h1 {

  text-align:center;

  color:#1e40af;

  font-size:45px;

}


.intro {

  text-align:center;

  font-size:20px;

  color:#475569;

  margin-bottom:50px;

}


.sections {

  display:grid;

  grid-template-columns:
  repeat(auto-fit,minmax(280px,1fr));

  gap:25px;

}


.card {

  background:white;

  padding:30px;

  border-radius:20px;

  text-decoration:none;

  color:#1e293b;

  border-left:5px solid #2563eb;

  box-shadow:0 8px 20px rgba(0,0,0,.08);

  transition:.3s;

}


.card:hover {

  transform:translateY(-8px);

}


.card h2 {

  color:#1e40af;

}


.card p {

  line-height:1.7;

}


</style>

</Layout>