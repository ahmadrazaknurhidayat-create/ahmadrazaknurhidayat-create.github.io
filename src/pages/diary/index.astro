---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Catatan Harian">

<section class="diary">

  <div class="container">

    <h1>
      📖 Catatan Harian
    </h1>

    <p class="intro">
      Setiap cerita memiliki lembarannya sendiri,
      dan setiap kenangan memiliki maknanya.
    </p>


    <div class="cards">


      <a href="/diary/cecilia" class="card cecilia">

        <div class="icon">
          💙
        </div>

        <h2>
          Kak Cecilia
        </h2>

        <p>
          Kumpulan kenangan, pesan,
          dan cerita yang tersimpan.
        </p>

        <span>
          Buka Lembaran →
        </span>

      </a>



      <a href="/diary/mamayo" class="card mamayo">

        <div class="icon">
          🌸
        </div>

        <h2>
          Mamayo Naisu
        </h2>

        <p>
          Catatan perjalanan,
          obrolan, dan kebersamaan.
        </p>

        <span>
          Buka Lembaran →
        </span>

      </a>



      <a href="/diary/aku" class="card aku">

        <div class="icon">
          ✨
        </div>

        <h2>
          Diriku
        </h2>

        <p>
          Perjalanan hidup,
          refleksi, dan mimpi.
        </p>

        <span>
          Buka Lembaran →
        </span>

      </a>


    </div>


  </div>

</section>


<style>

.diary {

  min-height:80vh;

  padding:70px 20px;

  background:#f8fafc;

}


.container {

  max-width:1100px;

  margin:auto;

}


h1 {

  text-align:center;

  font-size:45px;

  color:#1e3a8a;

}


.intro {

  text-align:center;

  font-size:20px;

  color:#64748b;

  margin-bottom:50px;

}


.cards {

  display:grid;

  grid-template-columns:
  repeat(auto-fit,minmax(280px,1fr));

  gap:30px;

}


.card {

  background:white;

  padding:35px;

  border-radius:25px;

  text-decoration:none;

  color:#1f2937;

  box-shadow:0 10px 25px rgba(0,0,0,.08);

  transition:.3s;

}


.card:hover {

  transform:translateY(-10px);

}


.icon {

  font-size:50px;

}


.card h2 {

  margin-top:20px;

}


.card p {

  line-height:1.7;

}


.card span {

  display:block;

  margin-top:20px;

  font-weight:bold;

}


.cecilia {

  border-top:6px solid #2563eb;

}


.mamayo {

  border-top:6px solid #ec4899;

}


.aku {

  border-top:6px solid #f59e0b;

}


@media(max-width:768px){

  h1 {

    font-size:35px;

  }


  .card {

    padding:25px;

  }

}

</style>

</Layout>