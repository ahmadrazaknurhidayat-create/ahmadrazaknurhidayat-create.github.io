---
import Clock from "./Clock.astro";
import "../styles/hero.css";
---

<section class="hero">

  <div class="hero-content">

    <span class="hero-subtitle">
      ✨ Sebuah Ruang untuk Menyimpan Cerita
    </span>

    <h1 class="hero-title">
      📚 Lembaran Memori
    </h1>

    <Clock />

    <p class="hero-quote">
      <strong>Every memory deserves its own page.</strong>
    </p>

    <p class="hero-description">
      Selamat datang di <strong>Lembaran Memori</strong>,
      sebuah ruang digital untuk menyimpan perjalanan hidup,
      catatan harian, puisi, renungan Islami,
      dan berbagai kenangan yang ingin terus dikenang.
    </p>

    <div class="hero-buttons">

      <a href="/diary" class="btn-primary">
        📖 Mulai Membaca
      </a>

      <a href="/about" class="btn-secondary">
        👤 Tentang Saya
      </a>

    </div>

    <div class="scroll-indicator">
      ↓
    </div>

  </div>

</section>