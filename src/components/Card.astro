---
import "../styles/cards.css";

interface Props {
  title: string;
  date?: string;
  description: string;
  href: string;
  image?: string;
  icon?: string;
}

const {
  title,
  date,
  description,
  href,
  image,
  icon = "📖"
}: Props = Astro.props;
---

<article class="card">
  {image && (
    <img src={image} alt={title} class="card-image" />
  )}

  <div class="card-content">
    {date && <p class="card-date">📅 {date}</p>}

    <h2>{icon} {title}</h2>

    <p>{description}</p>

    <a href={href} class="card-button">
      📖 Buka Lembaran →
    </a>
  </div>
</article>