---
interface Props {
  title: string;
  date?: string;
  description: string;
  href: string;
  image?: string;
}

const {
  title,
  date,
  description,
  href,
  image
} = Astro.props;
---

<article class="card">

  {image && (
    <img src={image} alt={title} class="card-image" />
  )}

  <div class="card-content">

    {date && <p class="card-date">📅 {date}</p>}

    <h2>{title}</h2>

    <p>{description}</p>

    <a href={href} class="card-button">
      Baca Catatan →
    </a>

  </div>

</article>

<style>
.card{
  background:#fff;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 8px 25px rgba(0,0,0,.08);
  transition:.3s;
  display:flex;
  flex-direction:column;
}

.card:hover{
  transform:translateY(-6px);
  box-shadow:0 16px 35px rgba(0,0,0,.15);
}

.card-image{
  width:100%;
  height:220px;
  object-fit:cover;
}

.card-content{
  padding:24px;
}

.card-date{
  color:#777;
  font-size:.9rem;
  margin-bottom:10px;
}

.card h2{
  margin:0 0 15px;
}

.card p{
  color:#555;
  line-height:1.7;
}

.card-button{
  display:inline-block;
  margin-top:20px;
  text-decoration:none;
  color:white;
  background:#2563eb;
  padding:10px 18px;
  border-radius:8px;
  transition:.3s;
}

.card-button:hover{
  background:#1d4ed8;
}
</style>