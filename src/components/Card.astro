---
import "../styles/cards.css";

interface Props {
  title: string;
  description: string;
  href: string;

  date?: string;
  image?: string;
  icon?: string;
  buttonText?: string;
}

const {
  title,
  description,
  href,
  date,
  image,
  icon = "📖",
  buttonText = "📖 Buka Lembaran →"
}: Props = Astro.props;
---

<article class="card">

  {image && (
    <div class="card-image-wrapper">
      <img
        src={image}
        alt={title}
        class="card-image"
        loading="lazy"
      />
    </div>
  )}

  <div class="card-content">

    {date && (
      <p class="card-date">
        📅 {date}
      </p>
    )}

    <div class="card-icon">
      {icon}
    </div>

    <h2 class="card-title">
      {title}
    </h2>

    <p class="card-description">
      {description}
    </p>

    <a href={href} class="card-button">
      {buttonText}
    </a>

  </div>

</article>