---
import logo from "../image/logo-lembaran-memori.png";
---

<nav class="navbar">
  <div class="container">

    <div class="logo">
      <img src={logo.src} alt="Logo Lembaran Memori" />
      <h2>Lembaran Memori</h2>
    </div>

     <div class="datetime">
    <div id="greeting"></div>
    <div id="clock"></div>
  </div>

    <ul class="menu">
      <li><a href="/">Beranda</a></li>
      <li><a href="/diary">Catatan Harian</a></li>
      <li><a href="/puisi">Puisi</a></li>
      <li><a href="/kenangan">Kenangan</a></li>
      <li><a href="/islami">Tulisan Islami</a></li>
      <li><a href="/about">Tentang</a></li>
    </ul>

  </div>
</nav>
<script is:inline>

function updateClock() {

  const greeting = document.getElementById("greeting");
  const clock = document.getElementById("clock");

  if (!greeting || !clock) return;

  const now = new Date();

  const hour = now.getHours();

  let text = "🌙 Selamat Malam";

  if (hour >= 5 && hour < 11) {
    text = "🌅 Selamat Pagi";
  } else if (hour >= 11 && hour < 15) {
    text = "☀️ Selamat Siang";
  } else if (hour >= 15 && hour < 18) {
    text = "🌇 Selamat Sore";
  }

  const date = now.toLocaleDateString("id-ID", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric"
  });

  const time = now.toLocaleTimeString("id-ID", {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit"
  });

  greeting.textContent = text;
  clock.textContent = `📅 ${date} | 🕒 ${time} WIT`;

}

updateClock();

setInterval(updateClock, 1000);

</script>

<style>
.navbar{
    position: sticky;
    top: 0;
    z-index: 1000;

    background: linear-gradient(90deg,#1e3a8a,#2563eb);
    box-shadow:0 4px 10px rgba(0,0,0,.15);
    padding:15px 0;
}

.container{
    max-width:1200px;
    margin:0 auto;
    padding:0 20px;

    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
}

.logo img{
    width:60px;
    height:60px;
    border-radius:50%;
    object-fit:cover;
}

.logo h2{
    margin:0;
    color:white;
    font-size:26px;
    font-weight:bold;
}

/* ===== Tanggal & Jam ===== */

.datetime{

    display:flex;
    flex-direction:column;

    align-items:center;

    justify-content:center;

    color:white;

    min-width:280px;

    text-align:center;

}

#greeting{

    color:#fde68a;

    font-size:15px;

    font-weight:bold;

    margin-bottom:4px;

}

#clock{

    font-size:13px;

    opacity:.9;

}

.menu{
    display:flex;
    gap:20px;
    list-style:none;
    margin:0;
    padding:0;
}
.menu{
    display:flex;
    gap:20px;
    list-style:none;
    margin:0;
    padding:0;
}

.menu li{
    list-style:none;
}

.menu a{
    color:white;
    text-decoration:none;
    font-weight:500;
    transition:0.3s;
}

.menu a:hover{
    color:#fde68a;
}

@media (max-width:768px){

.container{
    flex-direction:column;
    gap:20px;
}

.menu{
    flex-wrap:wrap;
    justify-content:center;
}

.logo img{
    width:50px;
    height:50px;
}

.logo h2{
    font-size:22px;
}
.datetime{

    margin:10px 0;

    font-size:12px;

}

#clock{

    font-size:12px;

}

}
</style>